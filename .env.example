# Copy this file to .env for local overrides (optional — the app works
# without it, using safe local defaults).
# On Render, you'll set these as real Environment Variables in the dashboard
# instead of using a .env file.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
# DATABASE_URL is provided automatically by Render when you attach a
# Postgres database. Locally, leave it unset to keep using db.sqlite3.
# DATABASE_URL=postgres://user:password@host:5432/dbname
